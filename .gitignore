# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
# Unanchored so workspace installs (apps/*/node_modules, packages/*/node_modules)
# are ignored too, not just the repo root.
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.lighthouseci/
/playwright-report/
/test-results/
/.playwright-mcp/
/*-mobile-*.png

# next.js
/.next/
/out/

# workspace build outputs
apps/*/.next/
apps/*/.lighthouseci/
apps/*/dist/
apps/*/.vercel/
packages/*/dist/

# sanity studio build output (created by `npx sanity deploy`)
/dist/
/.sanity/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local agent artifacts
.codex-*
.codex-artifacts/

# env files (can opt-in for committing if needed)
.env*
!apps/web/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.claude/

# local MCP server config — often holds API tokens, and this repo is public.
# Commit only a template that references env vars (git add -f), never real tokens.
.mcp.json
