# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
# Unanchored so workspace installs (apps/*/node_modules, packages/*/node_modules)
# are ignored too, not just the repo root.
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.lighthouseci/
/playwright-report/
/test-results/
/.playwright-mcp/
/*-mobile-*.png

# next.js
/.next/
/out/

# workspace build outputs
apps/*/.next/
apps/*/.lighthouseci/
apps/*/dist/
apps/*/.vercel/
packages/*/dist/

# sanity studio build output (created by `npx sanity deploy`)
/dist/
/.sanity/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local agent artifacts
.codex-*
.codex-artifacts/
# Scratch output from Codex runs. Untracked until now, which twice nearly went
# into a commit as 14k lines of noise.
.codex/tmp/

# env files (can opt-in for committing if needed)
.env*
!apps/web/.env.example

# downloaded credential files (Google OAuth client secrets, service accounts,
# application default credentials, and the API tokens kept as loose text files)
client_secret_*.json
*service-account*.json
google_adc.json
*token*.txt
*.key

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# .claude is local agent state and it sits right next to real credentials:
# OAuth client secrets, google_adc.json, Cloudflare and Vercel tokens.
# Ignore the whole thing, then re-allow only Markdown under .claude/skills/ —
# those are the skill pointer files. Nothing else in there can become tracked,
# so a key, token or JSON dropped into a skill folder stays ignored by default.
.claude/*
!.claude/skills/
.claude/skills/**
!.claude/skills/**/
!.claude/skills/**/*.md
