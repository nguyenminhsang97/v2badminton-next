# V2 Badminton Next - Local / Preview env template (apps/web)
# Copy to `apps/web/.env.local` for local work, or to your preview environment settings.
#
# Workspace note: this file is consumed by `apps/web` (and, during Gate A, the
# Studio mount at `/studio` inside the same app). Next.js and `sanity.cli.ts`
# read env via `loadEnvConfig(process.cwd())`, where cwd is `apps/web/` because
# npm scripts run in the workspace dir. Do NOT keep a root-level `.env.local`.
#
# Gate B will introduce a separate `apps/studio` Vercel project that needs
# ONLY the three vars marked `[Studio @ Gate B]` below. All other vars stay
# web-only.

# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=          # [Studio @ Gate B]
NEXT_PUBLIC_SANITY_DATASET=production   # [Studio @ Gate B]
NEXT_PUBLIC_SITE_URL=https://v2badminton.com  # [Studio @ Gate B] used by openLivePageAction
NEXT_PUBLIC_ALLOW_INDEXING=false
NEXT_PUBLIC_GTM_ID=
# GA4 Measurement ID (direct gtag.js integration, no GTM container required)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Optional. Keep empty while dataset is public.
SANITY_API_READ_TOKEN=
# Time-based ISR for Sanity reads — long safety net only. On-demand webhook
# revalidation (SANITY_REVALIDATE_SECRET below) is the real freshness path,
# so a short window just inflates Vercel ISR Writes with no benefit.
# Default if unset: 86400 (24h).
SANITY_REVALIDATE_SECONDS=86400
# On-demand revalidation: shared secret for Sanity webhook signature verification.
# Set this in Vercel AND in the Sanity webhook config to enable instant cache purge.
# Leave empty to rely on time-based ISR only (24h fallback).
SANITY_REVALIDATE_SECRET=

# Core save-first lead pipeline
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
FORM_TOKEN_SECRET=

# Telegram lead notify
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email notify
RESEND_API_KEY=
NOTIFY_EMAIL_TO=
# Required for production deliverability. Preview may fall back to Resend sandbox.
NOTIFY_EMAIL_FROM=

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Rate limit
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sentry baseline
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Internal preview-only monitoring helpers
ENABLE_MONITORING_TEST_ROUTES=false

# Ops / alerting
# Optional. If set with TELEGRAM_BOT_TOKEN, degraded integrations can ping ops chat.
TELEGRAM_OPS_CHAT_ID=
